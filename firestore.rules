rules_version = '2';

// 新海排班系統 — Firestore 安全規則
// 權限等級（存在 access/{Gmail}.perm）：
//   view   僅檢視：看班表、請假、休假日、規則
//   self   登記本人請假：view + 登記/變更自己的請假與家庭照顧假 + 看自己的薪資
//   manage 排班管理：可以改班表、所有人的請假、規則、薪資
//   super  超級管理員：manage + 個資 + 設定權限
// OWNERS 裡的 Gmail 不需要綁定，一律是 super（要和 index.html 的 OWNER_EMAILS 一致）。
// 更新方式：Firebase 主控台 → Firestore Database → 規則 → 貼上整份 → 發布。

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function email() { return request.auth.token.email.lower(); }
    function isOwner() {
      return signedIn() && email() in ['ccs93611@gmail.com'];
    }
    function accPath() { return /databases/$(database)/documents/access/$(email()); }
    function hasAcc() { return signedIn() && exists(accPath()); }
    function perm() {
      return isOwner() ? 'super' : (hasAcc() ? get(accPath()).data.perm : 'none');
    }
    function mySid() { return hasAcc() ? get(accPath()).data.staffId : ''; }

    // 打卡裝置（kiosk.html）：匿名登入，雙軌核准，任一成立即可：
    //   1) devices/{uid}.approved == true（以裝置代碼核准）
    //   2) devices/{uid}.hwId 指向的 hw/{裝置編號}.approved == true（App 才有裝置編號；代碼變了也沿用）
    function devPath() { return /databases/$(database)/documents/devices/$(request.auth.uid); }
    function hwPath(id) { return /databases/$(database)/documents/hw/$(id); }
    function isKiosk() {
      return request.auth != null && exists(devPath()) && (
        get(devPath()).data.approved == true ||
        (('hwId' in get(devPath()).data) && exists(hwPath(get(devPath()).data.hwId))
          && get(hwPath(get(devPath()).data.hwId)).data.approved == true));
    }
    function myHwId() { return request.auth != null && exists(devPath()) && ('hwId' in get(devPath()).data) ? get(devPath()).data.hwId : ''; }

    function canView()   { return perm() in ['view', 'self', 'manage', 'super']; }
    function canManage() { return perm() in ['manage', 'super']; }
    function isSuper()   { return perm() == 'super'; }
    function isSelf(sid) { return perm() in ['self', 'manage', 'super'] && sid == mySid(); }

    // 班表、人員、設定：所有已開通的人可看，排班管理以上可改
    // 打卡裝置要讀班表（判斷上班／下班）與人員名單（顯示姓名）
    match /weeks/{wk}      { allow read: if canView() || isKiosk(); allow write: if canManage(); }
    // 原始班表（定案時的當月班表）：所有已開通的人可看，排班管理以上可定案
    match /baselines/{ym}  { allow read: if canView(); allow write: if canManage(); }
    match /staff/{id}      { allow read: if canView() || isKiosk(); allow write: if canManage(); }

    // ---- 出勤打卡 ----
    // 打卡裝置：裝置自己建立「等待核准」的紀錄；核准、改名、停用、刪除由排班管理以上處理
    match /devices/{uid} {
      allow read: if canManage() || (request.auth != null && request.auth.uid == uid);
      allow create: if canManage() || (request.auth != null && request.auth.uid == uid
        && request.resource.data.approved == false
        && request.resource.data.keys().hasOnly(['name', 'approved', 'at', 'ua', 'hwId', 'model']));
      // 裝置自己只能補上裝置編號與型號（舊版登記的裝置），其他欄位由管理者處理
      allow update: if canManage() || (request.auth != null && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hwId', 'model']));
      allow delete: if canManage();
    }
    // 裝置編號 hw/{裝置編號}：App 回報；管理者核准後，同一台平板換了代碼也能打卡
    match /hw/{hid} {
      allow read: if canManage() || myHwId() == hid;
      allow create: if canManage() || (myHwId() == hid
        && request.resource.data.approved == false
        && request.resource.data.keys().hasOnly(['approved', 'at', 'platform', 'model']));
      allow update, delete: if canManage();
    }
    // 打卡紀錄 punches/{id}：裝置只能新增（不能改、不能刪），且必須標明是自己這台裝置、時間不能在未來；
    // 補登、作廢由排班管理以上處理；本人可以看自己的
    match /punches/{id} {
      // 被指定為審核醫師的人可以讀到指定給自己的加班申請
      allow read: if canManage() || isKiosk() || (signedIn() && resource.data.staffId == mySid())
        || (signedIn() && mySid() != '' && resource.data.ot.reviewer == mySid());
      // 管理者補登：排班管理只能新增待審的加班；直接新增已核准的加班限超級管理員
      allow create: if isSuper()
        || (canManage() && (!('ot' in request.resource.data) || request.resource.data.ot.status == 'pending'))
        || (isKiosk()
        && request.resource.data.src == 'kiosk'
        && request.resource.data.device == request.auth.uid
        && request.resource.data.staffId is string
        && request.resource.data.ts is number
        && request.resource.data.ts < request.time.toMillis() + 5 * 60 * 1000
        // 加班申請只能是待審（由審核醫師或超級管理員審核）
        && (!('ot' in request.resource.data) || request.resource.data.ot.status == 'pending'));
      // 加班審核（ot 欄位）：只有超級管理員，或被指定的審核醫師（只能改 ot、不能換審核醫師）
      // 排班管理可以補登、作廢，但不能動 ot
      allow update: if isSuper()
        || (canManage() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ot']))
        // 打卡裝置：員工用同一班的新加班申請取代前一筆時，只能把「待審」改成「已被取代」
        || (isKiosk() && resource.data.ot.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ot'])
            && request.resource.data.ot.status == 'replaced'
            && request.resource.data.ot.min == resource.data.ot.min
            && request.resource.data.ot.reason == resource.data.ot.reason)
        || (signedIn() && mySid() != '' && resource.data.ot.reviewer == mySid()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ot'])
            && request.resource.data.ot.reviewer == resource.data.ot.reviewer)
        // 審核醫師核准新申請時，可以把同一班「已核准」的前一筆改成「已被取代」（新申請的 ot.prev 指向這一筆、且由自己審核）
        || (signedIn() && mySid() != '' && resource.data.ot.status == 'approved'
            && request.resource.data.ot.status == 'replaced'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ot'])
            && get(/databases/$(database)/documents/punches/$(request.resource.data.ot.replacedBy)).data.ot.reviewer == mySid()
            && get(/databases/$(database)/documents/punches/$(request.resource.data.ot.replacedBy)).data.staffId == resource.data.staffId
            && get(/databases/$(database)/documents/punches/$(request.resource.data.ot.replacedBy)).data.ot.prev.id == id);
      allow delete: if canManage();
    }
    // 臉部特徵值 faces/{staffId}：在打卡裝置上登錄（需裝置管理密碼）；排班管理以上可刪除
    match /faces/{sid} {
      allow read: if isKiosk() || canManage();
      allow write: if isKiosk() || canManage();
    }
    // 出勤規則與裝置管理密碼
    // kiosk/settings 含裝置管理密碼，只給裝置與排班管理；kiosk/rules 是不含密碼的出勤規則，所有已開通的帳號可讀（計算自己的出勤）
    match /kiosk/{doc} {
      allow read: if isKiosk() || canManage() || (doc == 'rules' && canView());
      allow write: if canManage();
    }
    match /config/{id}     { allow read: if canView(); allow write: if canManage(); }

    // 請假、家庭照顧假：排班管理以上可改所有人；一般助理只能新增/變更/刪除自己的
    match /leaves/{id} {
      allow read: if canView();
      allow create: if canManage() || isSelf(request.resource.data.staffId);
      allow update: if canManage() || (isSelf(resource.data.staffId) && isSelf(request.resource.data.staffId));
      allow delete: if canManage() || isSelf(resource.data.staffId);
    }
    match /familyCare/{id} {
      allow read: if canView();
      allow create: if canManage() || isSelf(request.resource.data.staffId);
      allow update: if canManage() || (isSelf(resource.data.staffId) && isSelf(request.resource.data.staffId));
      allow delete: if canManage() || isSelf(resource.data.staffId);
    }

    // 事假補班：規則同請假
    match /makeups/{id} {
      allow read: if canView();
      allow create: if canManage() || isSelf(request.resource.data.staffId);
      allow update: if canManage() || (isSelf(resource.data.staffId) && isSelf(request.resource.data.staffId));
      allow delete: if canManage() || isSelf(resource.data.staffId);
    }

    // 個人假事件（結婚日、死亡日、預產期、產假／育嬰假起訖等）：規則同請假
    match /personalEvents/{id} {
      allow read: if canView();
      allow create: if canManage() || isSelf(request.resource.data.staffId);
      allow update: if canManage() || (isSelf(resource.data.staffId) && isSelf(request.resource.data.staffId));
      allow delete: if canManage() || isSelf(resource.data.staffId);
    }

    // 排休抽籤：lottery/{YYYY-MM} 由管理者設定；開獎時間到後，參加的助理（任何一人開著頁面）可以寫入開獎結果；所有人都「下好離手」時，參加者可以把本輪截止提前到現在（之後倒數 5 秒開獎）
    match /lottery/{ym} {
      allow read: if canView();
      allow create, delete: if canManage();
      allow update: if canManage() || (canView() && mySid() in resource.data.participants
        && resource.data.status == 'open' && request.time.toMillis() >= resource.data.roundEndsAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lock', 'rounds', 'round', 'status', 'won', 'left', 'roundEndsAt']))
        || (canView() && mySid() in resource.data.participants && resource.data.status == 'open'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roundEndsAt', 'earlyAt'])
        && request.resource.data.roundEndsAt < resource.data.roundEndsAt
        && request.resource.data.roundEndsAt > request.time.toMillis() - 60000
        && request.resource.data.roundEndsAt < request.time.toMillis() + 10000);
    }
    // 籌碼：lotteryBets/{YYYY-MM}_{輪次}_{sid}，只能放自己的，而且要在本輪截止前
    match /lotteryBets/{id} {
      allow read: if canView();
      allow write: if canManage() || (canView() && request.resource.data.sid == mySid()
        && id == request.resource.data.ym + '_' + string(request.resource.data.round) + '_' + mySid()
        && lotOpen(request.resource.data.ym, request.resource.data.round));
    }
    function lotOpen(ym, round) {
      let L = get(/databases/$(database)/documents/lottery/$(ym)).data;
      return L.status == 'open' && L.round == round && mySid() in L.participants && request.time.toMillis() < L.roundEndsAt;
    }

    // 薪資：只有超級管理員可看可改所有人；其他人（含排班管理）只能看自己的
    // pay/{staffId}_{YYYY-MM}：每人每月一筆
    match /pay/{id} {
      allow read: if isSuper() || (signedIn() && resource.data.staffId == mySid());
      allow write: if isSuper();
    }

    // 個資：只有超級管理員
    match /data/private/people/{id} { allow read, write: if isSuper(); }

    // 帳號綁定與權限：超級管理員可管理；每個人可以讀自己的那一筆
    match /access/{mail} {
      allow read: if isSuper() || (signedIn() && mail == email());
      allow write: if isSuper();
    }
  }
}
